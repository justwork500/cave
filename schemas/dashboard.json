{
  "$defs": {
    "ButtonCard": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "pattern": "^(automation|sequence)\\.[a-z0-9_-]{1,64}$|^script\\.[A-Za-z0-9_.-]{1,64}\\.(ps1|py|sh)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "blue",
                "green",
                "amber",
                "red",
                "purple"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "command": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "confirm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm"
        },
        "entity": {
          "anyOf": [
            {
              "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "h": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        },
        "icon": {
          "anyOf": [
            {
              "enum": [
                "lightbulb",
                "plug",
                "power",
                "wind",
                "fire",
                "temperature",
                "drop",
                "sun",
                "snow",
                "door",
                "lock",
                "shield",
                "camera",
                "speaker",
                "tv",
                "home",
                "bed",
                "clock",
                "play",
                "battery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "button",
          "title": "Type",
          "type": "string"
        },
        "w": {
          "default": 3,
          "maximum": 12,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "ButtonCard",
      "type": "object"
    },
